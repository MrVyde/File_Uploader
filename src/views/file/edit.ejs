<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>File-Uploader | Rename File</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <div id="fileRenameModal" class="modal hidden">
    <div class="modal-content">

      <div class="modal-header">
        <h3>Rename File</h3>
        <button id="closeFileModal">&times;</button>
      </div>

      <form id="fileRenameForm" method="POST">
        <input type="text" name="filename" id="fileNameInput" value="<%= oldInput?.filename || '' %>" required>
        <button type="submit" class="btn btn-primary">Save</button>
      </form>

    </div>
  </div>

  <script>
    function openFileRenameModal(id, name) {
    const modal = document.getElementById("fileRenameModal");
    const input = document.getElementById("fileNameInput");
    const form = document.getElementById("fileRenameForm");

    input.value = name;
    form.action = `/files/${id}/rename`;

    modal.classList.remove("hidden");
    }

    document.getElementById("closeFileModal").addEventListener("click", () => {
    document.getElementById("fileRenameModal").classList.add("hidden");
    });
  </script>
</body>
</html>