<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>File-Uploader | Sign In</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <!-- Navbar -->
  <header class="navbar">
    <h1 class="logo">File-Uploader</h1>
    <div class="nav-buttons">
      <a href="/" class="btn btn-secondary">Home</a>
      <a href="/api/users/new" class="btn btn-primary">Sign Up</a>
    </div>
  </header>

  <!-- Sign In Form -->
  <main class="form-wrapper">
    <div class="form-card">
      <h2>Sign In</h2>

      <%- include("../partials/errors") %>
      <form action="/api/users/login" method="POST">

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="Enter your email" value="<%= old?.email || '' %>" required>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Enter your password" required>
        </div>

        <button type="submit" class="btn btn-primary form-btn">Login</button>

      </form>

      <p class="form-footer">
        Don't have an account? <a href="/api/users/new">Sign Up</a>
      </p>

    </div>
  </main>

</body>
</html>