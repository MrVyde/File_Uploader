<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>File Uploader</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>

  <!-- Top Bar -->
  <header class="top-bar">
    <h1>File Uploader</h1>

    <div class="top-actions">
      <% if (!currentUser) { %>
        <!-- Guest -->
        <div class="nav-auth">
          <a href="/api/users/login" class="btn btn-secondary">Login</a>
          <a href="/api/users/new" class="btn btn-primary">Sign Up</a>
      </div>
      <% } else { %>
        <!-- Logged in -->
        <span>Welcome, <%= currentUser.firstName %></span>
        <form action="/api/users/logout" method="POST">
          <button type="submit">Logout</button>
        </form>
      <% } %>
    </div>
  </header>
  <%- include("partials/errors") %>

  <!-- MAIN CONTENT -->
  <% if (!currentUser) { %>
    <!-- Guest View -->
    <div class="guest-wrapper">
      <div class="guest-card">
        <h2>Welcome to File Uploader</h2>
        <p>Sign up or log in to create folders and upload files.</p>

        <div class="auth-buttons">
          <a href="/api/users/new" class="btn btn-primary">Sign Up</a>
          <a href="/api/users/login" class="btn btn-secondary">Login</a>
        </div>
      </div>
    </div>

  <% } else { %>
    <!-- Logged-in View -->
    <div class="container">

      <!-- Sidebar -->
      <aside class="sidebar">
        <h2>Folders</h2>

        <!-- Create Folder -->
        <form action="/folders/create" method="POST">
          <input type="text" name="name" placeholder="New Folder Name" value="<%= oldInput?.name || '' %>"  required>
          <button type="submit">Create</button>
        </form>

        <% if (folders.length === 0) { %>
          <p>No folders yet.</p>
        <% } else { %>
          <ul class="folder-list">
            <% folders.forEach(folder => { %>
              <li class="folder-item <%= activeFolder && activeFolder.id === folder.id ? 'active' : '' %>">

                <a href="/?folderId=<%= folder.id %>" class="folder-link">
                  <%= folder.name %>
                </a>

                <div class="folder-actions">
                   <button type="button" class="action-share" onclick="openShareModal('<%= folder.id %>')">🔗</button>
                  <button type="button" class="action-edit edit-btn" data-id="<%= folder.id %>" data-name="<%= folder.name %>"> Edit </button>
                  <form action="/folders/<%= folder.id %>/delete" method="POST">
                    <button type="submit" class="action-delete">Delete</button>
                  </form>
                </div>

              </li>
            <% }) %>
          </ul>
        <% } %>
      </aside>

      <!-- Main Area -->
      <main class="main-content">
        <% if (activeFolder) { %>
          <div class="folder-header">
            <h3>
              <%= activeFolder.name %>
              <% if (activeFile) { %>
                &gt; <%= activeFile.filename %>
              <% } %>
            </h3>

            <button class="btn btn-primary" onclick="openUploadModal()">
              + Upload File
            </button>
          </div>
        <% } %>

        <% if (folders.length === 0) { %>
          <p>Create a folder to start uploading files.</p>
        <% } else { %>
          <% if (!activeFolder) { %>
                <p>No folder selected.</p>
              <% } else { %>
            <section class="folder-section">

              <% if (activeFolder.files.length === 0) { %>
                <p>No files</p>
              <% } else { %>
                <ul class="file-list">
                    <% activeFolder.files.forEach(file => { %>
                      <li class="file-item">

                        <!-- File name (click = details page) -->
                        <a href="/files/<%= file.id %>" class="file-link">
                          <%= file.filename %>
                        </a>

                        <!-- Hover actions -->
                        <div class="file-actions">

                          <!-- Rename -->
                          <button 
                            class="rename-btn"
                            onclick="openFileRenameModal('<%= file.id %>', '<%= file.filename %>')">
                            Rename
                          </button>

                          <!-- Delete -->
                          <form action="/files/<%= file.id %>?_method=DELETE" method="POST">
                            <button type="submit" class="delete-btn">Delete</button>
                          </form>

                        </div>

                      </li>
                    <% }) %>
                  </ul>
              <% } %>
            </section>
          <% } %>
        <% } %>
      </main>

    </div>
  <% } %>


<%- include("folder/edit") %>
<%- include("folder/share") %>
<%- include("file/create") %>
<%- include("file/edit") %>



<script>
  const modal = document.getElementById("renameModal");
  const closeModal = document.getElementById("closeModal");
  const input = document.getElementById("folderNameInput");
  const form = document.getElementById("renameForm");
  const fileInput = document.getElementById("fileInput");
  const label = fileInput.nextElementSibling;

  function openUploadModal() {
    document.getElementById("uploadModal").classList.remove("hidden");
  }

  function closeUploadModal() {
    document.getElementById("uploadModal").classList.add("hidden");
  }

  function openFileRenameModal(id, name) {
  const modal = document.getElementById("fileRenameModal");
  const input = document.getElementById("fileNameInput");
  const form = document.getElementById("fileRenameForm");

  input.value = name;
  form.action = `/files/${id}/rename`;

  modal.classList.remove("hidden");
  }

  document.getElementById("closeFileModal").addEventListener("click", () => {
    document.getElementById("fileRenameModal").classList.add("hidden");
  });

  document.querySelectorAll(".edit-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.id;
      const name = btn.dataset.name;

      input.value = name;
      form.action = `/folders/${id}/update`;

      modal.classList.remove("hidden");
    });
  });

  closeModal.addEventListener("click", () => {
    modal.classList.add("hidden");
  });

  fileInput.addEventListener("change", () => {
  if (fileInput.files.length > 0) {
    label.innerHTML = `<p>${fileInput.files[0].name}</p>`;
  }
  });
  // Optional: close when clicking outside
  modal.addEventListener("click", (e) => {
    if (e.target === modal) {
      modal.classList.add("hidden");
    }
  });
</script>
</body>
</html>